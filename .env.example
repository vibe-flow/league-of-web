# Project
COMPOSE_PROJECT_NAME="league-of-web"

# Database (via local-services)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/league?schema=public"

# Redis (via local-services)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend (Vite)
VITE_API_URL="http://localhost:3000"
VITE_TRPC_URL="http://localhost:3000/trpc"
VITE_WS_URL="ws://localhost:3000"

# Server
PORT="3000"
NODE_ENV="development"
